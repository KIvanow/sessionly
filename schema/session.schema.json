{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Session",
  "type": "object",
  "properties": {
    "schema_version": {
      "description": "Version of this record format.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0,
      "default": 0
    },
    "source": {
      "description": "Agent that produced the session, e.g. \"claude-code\".",
      "type": "string",
      "default": ""
    },
    "collector_version": {
      "description": "Version of the sessionly binary that built this record.",
      "type": "string",
      "default": ""
    },
    "machine_id": {
      "description": "Random id of the sessionly installation that captured the session.\nTogether with `source` and `session_id` it identifies the record.",
      "type": "string",
      "default": ""
    },
    "captured_by": {
      "description": "Where the activity (prompts, tool calls, files) was read from.",
      "$ref": "#/$defs/CapturedBy",
      "default": "hooks"
    },
    "content": {
      "description": "How much content the record carries. Records leave a machine only as\n`previews` or `metadata`.",
      "$ref": "#/$defs/Content",
      "default": "local"
    },
    "session_id": {
      "type": "string",
      "default": ""
    },
    "title": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "user": {
      "description": "Who ran the session: from git config on the machine that captured it,\nor, for a session that ran in the cloud, the person the platform says\nstarted it (git there is set up as the agent).",
      "anyOf": [
        {
          "$ref": "#/$defs/User"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "runtime": {
      "description": "Where the session ran, if not on a person's own machine.",
      "anyOf": [
        {
          "$ref": "#/$defs/Runtime"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "started_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "default": null
    },
    "ended_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "default": null
    },
    "duration_ms": {
      "description": "Wall-clock span from first to last activity. Includes idle time and gaps\nbetween resumes, so it can be days for a long-lived session.",
      "type": [
        "integer",
        "null"
      ],
      "format": "int64",
      "default": null
    },
    "active_ms": {
      "description": "Time the agent spent working on prompts (sum of prompt turn durations).",
      "type": "integer",
      "format": "int64",
      "default": 0
    },
    "end_reason": {
      "description": "Why the session last ended, as reported by the agent. Null while it is\nopen, including after it has been resumed.",
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "captured_from_start": {
      "description": "False when capture began partway through the session (the hooks were\ninstalled after it started). Prompts, tool calls and files then cover\nonly the captured part, while cost and usage cover the whole session.",
      "type": "boolean",
      "default": false
    },
    "cwd": {
      "description": "Working directory the session ran in.",
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "repo": {
      "anyOf": [
        {
          "$ref": "#/$defs/Repo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "agent_version": {
      "description": "Version of the agent CLI.",
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "entrypoint": {
      "description": "How the agent was started, e.g. \"cli\" or \"sdk-cli\"; for a cloud\nsession, what the platform says started it (\"remote_mobile\", \"website\").",
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "models": {
      "description": "Models that answered at least one request, most used first.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "permission_modes": {
      "description": "Permission modes seen during the session, in order of first use.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "cost": {
      "description": "Null when no transcript was available to read cost from.",
      "anyOf": [
        {
          "$ref": "#/$defs/Cost"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "usage": {
      "description": "Token usage per model, main thread and subagents combined.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/ModelUsage"
      },
      "default": []
    },
    "counts": {
      "$ref": "#/$defs/Counts",
      "default": {
        "events": 0,
        "prompts": 0,
        "tool_calls": 0,
        "tool_failures": 0,
        "permission_requests": 0,
        "permission_denials": 0,
        "subagents": 0,
        "compactions": 0,
        "api_errors": 0,
        "files_read": 0,
        "files_changed": 0,
        "lines_added": 0,
        "lines_removed": 0
      }
    },
    "prompts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Prompt"
      },
      "default": []
    },
    "tool_calls": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ToolCall"
      },
      "default": []
    },
    "files": {
      "description": "Files read or changed through the agent's file tools. What shell\ncommands changed is known only for a session in the cloud, where the\nworking tree is compared before and after each command.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/FileTouched"
      },
      "default": []
    },
    "subagents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Subagent"
      },
      "default": []
    },
    "instruction_files": {
      "description": "Instruction files (CLAUDE.md, rules) loaded into the session.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "$defs": {
    "CapturedBy": {
      "description": "Where a session's activity was read from.",
      "oneOf": [
        {
          "description": "Hook events, as they happened.",
          "type": "string",
          "const": "hooks"
        },
        {
          "description": "Reconstructed afterwards from the agent's transcript.",
          "type": "string",
          "const": "transcript"
        }
      ]
    },
    "Content": {
      "description": "How much content a record carries.",
      "oneOf": [
        {
          "description": "As built on the capturing machine: previews and absolute paths. Never uploaded.",
          "type": "string",
          "const": "local"
        },
        {
          "description": "Previews kept (the first 200 characters of prompts, shell commands,\nsearch patterns, URLs and error output). Paths are made relative.",
          "type": "string",
          "const": "previews"
        },
        {
          "description": "No text from prompts, commands or output at all: counts, sizes,\ntimings, tool names and relative file paths only.",
          "type": "string",
          "const": "metadata"
        }
      ]
    },
    "User": {
      "type": "object",
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "email": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      }
    },
    "Runtime": {
      "description": "A session that a cloud platform ran in a sandbox of its own: a Claude Code\ncloud session or a Cursor cloud agent. Such a record's `machine_id` is\n\"cloud\", since the sandbox is new each time.",
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/RuntimeKind",
          "default": "cloud"
        },
        "id": {
          "description": "The platform's own id for the session (`cse_…`, `bc-…`), which is\nwhat its web pages and API go by.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      }
    },
    "RuntimeKind": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "cloud"
          ]
        },
        {
          "description": "A value written by a newer version.",
          "type": "string",
          "const": "unknown"
        }
      ]
    },
    "Repo": {
      "type": "object",
      "properties": {
        "root": {
          "description": "Repository root on the capturing machine.",
          "type": "string",
          "default": ""
        },
        "remote": {
          "description": "`origin` remote as host/owner/repo, without credentials.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "branch": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      }
    },
    "Cost": {
      "type": "object",
      "properties": {
        "total_usd": {
          "description": "Best figure for the whole session, in USD.",
          "type": "number",
          "format": "double",
          "default": 0.0
        },
        "source": {
          "$ref": "#/$defs/CostSource",
          "default": "estimated"
        },
        "transcript_estimate_usd": {
          "description": "Estimate from the token counts visible in the transcript.",
          "type": "number",
          "format": "double",
          "default": 0.0
        },
        "unpriced_requests": {
          "description": "Requests the total leaves out: made on a model without a known price,\noutside any run the agent recorded a total for.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        },
        "untracked_usd": {
          "description": "Spend the agent recorded that the transcript does not show. Null when\nit can't be worked out (no recorded total, or a model without a known price).",
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "default": null
        },
        "prompts_covered": {
          "description": "How many of the session's prompts the figure covers, when it can't\ncover them all: an agent that reports usage only to hooks (Cursor) has\nnone for turns that ran before the hooks were installed. Null when the\nfigure covers the whole session.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0,
          "default": null
        }
      }
    },
    "CostSource": {
      "description": "Where a session's cost figure comes from.",
      "oneOf": [
        {
          "description": "The agent's own total, covering every message in the transcript.",
          "type": "string",
          "const": "recorded"
        },
        {
          "description": "The agent's total for one run, combined with our estimates for\nmessages outside that run.",
          "type": "string",
          "const": "recorded_and_estimated"
        },
        {
          "description": "Our estimate from token counts only. A lower bound: it misses calls\nthat never reach the transcript.",
          "type": "string",
          "const": "estimated"
        },
        {
          "description": "An estimate that leaves out requests to models without a known price.",
          "type": "string",
          "const": "partial_estimate"
        },
        {
          "description": "A value written by a newer version.",
          "type": "string",
          "const": "unknown"
        }
      ]
    },
    "ModelUsage": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "default": ""
        },
        "requests": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        },
        "input_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        },
        "output_tokens": {
          "description": "Includes thinking tokens.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        },
        "thinking_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        },
        "cache_read_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        },
        "cache_write_5m_tokens": {
          "description": "Cache writes with a 5-minute lifetime (1.25x the input price).",
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        },
        "cache_write_1h_tokens": {
          "description": "Cache writes with a 1-hour lifetime (2x the input price).",
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        },
        "estimated_cost_usd": {
          "description": "Null when the model has no known price.",
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "default": null
        }
      }
    },
    "Counts": {
      "type": "object",
      "properties": {
        "events": {
          "description": "Raw hook events the record was built from.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        },
        "prompts": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        },
        "tool_calls": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        },
        "tool_failures": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        },
        "permission_requests": {
          "description": "Times the user was asked to approve a tool call.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        },
        "permission_denials": {
          "description": "Tool calls refused by auto mode.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        },
        "subagents": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        },
        "compactions": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        },
        "api_errors": {
          "description": "Turns that ended in an API error.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        },
        "files_read": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        },
        "files_changed": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        },
        "lines_added": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        },
        "lines_removed": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        }
      }
    },
    "Prompt": {
      "type": "object",
      "properties": {
        "prompt_id": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "default": null
        },
        "text": {
          "$ref": "#/$defs/Text",
          "default": {
            "sha256": "",
            "chars": 0,
            "preview": ""
          }
        },
        "ended_at": {
          "description": "When the agent finished responding. Null if the turn was interrupted\nor is still running.",
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "default": null
        },
        "outcome": {
          "description": "Null if the turn was interrupted or is still running.",
          "anyOf": [
            {
              "$ref": "#/$defs/Outcome"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "error": {
          "description": "API error type when outcome is \"api_error\".",
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      }
    },
    "Text": {
      "description": "A piece of text kept as hash, length and short preview.",
      "type": "object",
      "properties": {
        "sha256": {
          "description": "SHA-256 of the full text, hex.",
          "type": "string",
          "default": ""
        },
        "chars": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        },
        "preview": {
          "description": "First characters of the text.",
          "type": "string",
          "default": ""
        }
      }
    },
    "Outcome": {
      "description": "How a prompt turn ended.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "completed",
            "api_error"
          ]
        },
        {
          "description": "A value written by a newer version.",
          "type": "string",
          "const": "unknown"
        }
      ]
    },
    "ToolCall": {
      "type": "object",
      "properties": {
        "tool_use_id": {
          "type": "string",
          "default": ""
        },
        "prompt_id": {
          "description": "Prompt turn the call belongs to.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "agent_id": {
          "description": "Set when a subagent made the call.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "tool": {
          "type": "string",
          "default": ""
        },
        "model": {
          "description": "Model that made the call. Null where the agent does not say: Grok, and\nCursor turns the hooks did not see.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "default": null
        },
        "status": {
          "$ref": "#/$defs/ToolStatus",
          "default": "no_result"
        },
        "duration_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0,
          "default": null
        },
        "file_path": {
          "description": "File the call operated on, for file tools.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "input_sha256": {
          "description": "SHA-256 of the full tool input (JSON), hex.",
          "type": "string",
          "default": ""
        },
        "input_summary": {
          "description": "Short human-readable summary of the input: the command, pattern, URL\nor description, depending on the tool.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "output_bytes": {
          "description": "Size of the tool's result as serialized JSON.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0,
          "default": null
        },
        "error": {
          "description": "Start of the error message for failed calls. For shell commands this\nis the start of the command's output.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "lines_added": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        },
        "lines_removed": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        }
      }
    },
    "ToolStatus": {
      "description": "How a tool call ended.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "ok",
            "failed"
          ]
        },
        {
          "description": "The user interrupted it.",
          "type": "string",
          "const": "interrupted"
        },
        {
          "description": "Refused by auto mode or a permission rule.",
          "type": "string",
          "const": "denied"
        },
        {
          "description": "The user declined the permission prompt. Known only for sessions read\nfrom a transcript; a hook-captured one shows `no_result` instead.",
          "type": "string",
          "const": "rejected"
        },
        {
          "description": "Attempted, but no result was captured: rejected by the user,\ninterrupted, or still running.",
          "type": "string",
          "const": "no_result"
        },
        {
          "description": "A value written by a newer version.",
          "type": "string",
          "const": "unknown"
        }
      ]
    },
    "FileTouched": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "default": ""
        },
        "reads": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        },
        "writes": {
          "description": "Successful write or edit calls.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        },
        "created": {
          "description": "True if the agent created the file in this session.",
          "type": "boolean",
          "default": false
        },
        "lines_added": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        },
        "lines_removed": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        }
      }
    },
    "Subagent": {
      "type": "object",
      "properties": {
        "agent_id": {
          "type": "string",
          "default": ""
        },
        "agent_type": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "description": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "default": null
        },
        "ended_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "default": null
        },
        "tool_calls": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        },
        "requests": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        },
        "input_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        },
        "output_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        },
        "estimated_cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "default": null
        }
      }
    }
  }
}
