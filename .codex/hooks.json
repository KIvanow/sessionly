{
  "description": "Probe: does Codex in the cloud run a repository's hooks? Not for merging.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/probe/codex-cloud-hook.sh\" repo SessionStart"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/probe/codex-cloud-hook.sh\" repo UserPromptSubmit"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/probe/codex-cloud-hook.sh\" repo PreToolUse"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/probe/codex-cloud-hook.sh\" repo Stop"
          }
        ]
      }
    ]
  }
}
