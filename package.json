{
  "name": "sessionly-workspace",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "gen": "pnpm --filter @sessionly/schema gen",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "server": "pnpm --filter @sessionly/server start",
    "token": "pnpm --filter @sessionly/server token",
    "person": "pnpm --filter @sessionly/server person",
    "org": "pnpm --filter @sessionly/server org",
    "build": "pnpm --filter @sessionly/web build",
    "dev": "pnpm --filter @sessionly/web dev"
  }
}
