# In front of the hosted service: TLS, and the copies of the server behind it.
{$SESSIONLY_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	reverse_proxy {
		# Every copy of the server answers to the name "server". Asked again
		# every few seconds, so copies that come and go are found.
		dynamic a server 8080 {
			refresh 5s
		}
		lb_policy round_robin
		# A copy that is being replaced refuses connections for a moment
		# before it is noticed gone: the request goes to another instead.
		lb_try_duration 5s
		lb_try_interval 250ms
		health_uri /healthz
		health_interval 5s
		health_timeout 3s
	}
}
