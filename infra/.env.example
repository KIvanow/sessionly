# Settings of the hosted service. Copy to .env, fill in, chmod 600.

# Where people reach it. Its DNS must point at this machine before the first start.
SESSIONLY_DOMAIN=app.example.com

# The release to run: a tag of ghcr.io/kivanow/sessionly-server, such as v0.4.0.
# With --build, any name for what this checkout builds, such as "local".
SESSIONLY_VERSION=

# The managed Postgres. Give it the certificate authority the provider lets you
# download, so the connection is verified:
#   DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DB?sslmode=verify-full&sslrootcert=/etc/sessionly/db-ca.crt
#   DATABASE_CA_FILE=/opt/sessionly/infra/ca-certificate.crt
DATABASE_URL=
DATABASE_CA_FILE=
# Connections each copy of the server keeps open at most. Copies times this
# must stay under what the database allows.
SESSIONLY_DB_POOL=8
# How long a statement may take, in seconds. A connection that has not
# answered a fifth of this later is thrown away, which is how the server
# gets over a database that failed over and left its connections silent.
SESSIONLY_DB_QUERY_SECONDS=30
SESSIONLY_REPLICAS=2

# People sign in with Google or GitHub: set up one of them, or both. Each is
# an id and a secret from the provider's settings, where the address people
# are sent back to must be given exactly:
#   Google (an OAuth client of type "Web application"):
#     https://<SESSIONLY_DOMAIN>/api/v1/auth/google/callback
#   GitHub (an OAuth app):
#     https://<SESSIONLY_DOMAIN>/api/v1/auth/github/callback
SESSIONLY_GOOGLE_CLIENT_ID=
SESSIONLY_GOOGLE_CLIENT_SECRET=
SESSIONLY_GITHUB_CLIENT_ID=
SESSIONLY_GITHUB_CLIENT_SECRET=

# Who may create an organisation: "open" for anyone, "off" for nobody.
SESSIONLY_SIGNUP=open
# If set, signing up needs this code too (a waiting list, or invitations).
SESSIONLY_SIGNUP_CODE=

# What is kept of the email addresses on a pull request's commits is hashed with
# this, so that it cannot be made from a guessed address by someone who has only
# the database. 32 characters or more: openssl rand -hex 32. Keep it secret, and
# keep it: with another, pull requests have to be reported once more before their
# lines can be matched to sessions again.
SESSIONLY_HASH_KEY=

# One repository's sessions, uploaded to the organisation FROM, shown in the
# organisation ORG without anything that was typed or run: a demo of real work.
# All three or none; the ids are the organisations' (see the docs' page on the
# server's settings). HIDE: what of the repository not to show, comma-separated:
# file names, paths and folders, and patterns with *, as the Action's ignore.
# `node src/cli.ts demo import` (in /app/ee) copies them; run it again (from cron) to bring ORG up to date.
SESSIONLY_DEMO_FROM=
SESSIONLY_DEMO_REPO=
SESSIONLY_DEMO_ORG=
SESSIONLY_DEMO_HIDE=

# Requests one token may make a minute.
SESSIONLY_RATE_PER_MINUTE=600
# Organisations created an hour, by everyone together.
SESSIONLY_SIGNUPS_PER_HOUR=100
# Organisations created an hour from one network (a /24, or a /48 of IPv6).
# An office or a phone network shares one.
SESSIONLY_SIGNUPS_PER_NETWORK=10
