# Settings of the hosted service. Copy to .env, fill in, chmod 600.

# Where people reach it. Its DNS must point at this machine before the first start.
SESSIONLY_DOMAIN=app.example.com

# The release to run: a tag of ghcr.io/kivanow/sessionly-server, such as v0.4.0.
# With --build, any name for what this checkout builds, such as "local".
SESSIONLY_VERSION=

# The managed Postgres. Give it the certificate authority the provider lets you
# download, so the connection is verified:
#   DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DB?sslmode=verify-full&sslrootcert=/etc/sessionly/db-ca.crt
#   DATABASE_CA_FILE=/opt/sessionly/infra/ca-certificate.crt
DATABASE_URL=
DATABASE_CA_FILE=
# Connections each copy of the server keeps open at most. Copies times this
# must stay under what the database allows.
SESSIONLY_DB_POOL=8
# How long a statement may take, in seconds. A connection that has not
# answered a fifth of this later is thrown away, which is how the server
# gets over a database that failed over and left its connections silent.
SESSIONLY_DB_QUERY_SECONDS=30
SESSIONLY_REPLICAS=2

# Outgoing mail, for the links people sign in and sign up with, goes through
# Resend (https://resend.com). A key with "Sending access" is all it needs.
# The address the links come from must be on a domain verified there.
RESEND_API_KEY=
SESSIONLY_EMAIL_FROM=Sessionly <sign-in@example.com>

# Who may create an organisation: "open" for anyone, "off" for nobody.
SESSIONLY_SIGNUP=open
# If set, signing up needs this code too (a waiting list, or invitations).
SESSIONLY_SIGNUP_CODE=

# Requests one token may make a minute.
SESSIONLY_RATE_PER_MINUTE=600
# Links to finish signing up sent an hour, to everyone together.
SESSIONLY_SIGNUPS_PER_HOUR=100
# Sign-ups asked for an hour from one network (a /24, or a /48 of IPv6). An
# office or a phone network shares one.
SESSIONLY_SIGNUPS_PER_NETWORK=10
